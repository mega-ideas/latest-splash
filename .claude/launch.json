{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "splash-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3010,
      "autoPort": true,
      "env": {
        "TEMP": "D:/splash-base/.tmp",
        "TMP": "D:/splash-base/.tmp",
        "TMPDIR": "D:/splash-base/.tmp",
        "NEXT_TELEMETRY_DISABLED": "1",
        "NODE_OPTIONS": "--use-system-ca",
        "PORT": "3010"
      }
    }
  ]
}
