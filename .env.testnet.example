SUI_NETWORK=testnet
SUI_RPC_URL=
# ── Package IDs (post-split) ────────────────────────────────────────────────
# splash_core publishes to mainnet. Required.
SPLASH_CORE_PACKAGE_ID=
# splash_custody publishes ONLY when the Labuan e-money licence is granted.
# Leave EMPTY in Phase 0 — that is the regulatory posture, not a misconfiguration.
# Batch settlement will refuse with a licence-named error. See STATUS.md.
SPLASH_CUSTODY_PACKAGE_ID=
# The tenant-granted payout delegation the operator settles batches with (A-11).
# Granted by the tenant from their own wallet via settlement::grant_delegation,
# transferred to the operator, TTL <= 30 days. Absent in Phase 0 along with the
# rest of custody.
SPLASH_PAYOUT_DELEGATION_ID=
# Legacy single-package id. Still honoured for pre-split deployments: when
# SPLASH_CORE_PACKAGE_ID is unset, core AND custody both resolve to this.
SPLASH_PACKAGE_ID=
SPLASH_TREASURY_ID=
SPLASH_PEG_STATE_ID=
SPLASH_COMPLIANCE_CONFIG_ID=
SPLASH_COMPLIANCE_CAP_ID=
DEEPBOOK_POOL_ID=
DEEPBOOK_QUOTE_TYPE=
USDC_TYPE=0x2::sui::SUI
USDT_TYPE=
USDT_BUFFER_ID=
MIN_USDC_FLOAT_MICRO=100000000
TREASURY_ADDRESS=
ENOKI_API_KEY=
OPERATOR_SUI_ADDRESS=
# Server-side funded Ed25519 or Secp256k1 suiprivkey. Never expose to the browser.
OPERATOR_SUI_PRIVATE_KEY=
# Use live for real testnet settlement after the signer is configured.
SUI_SETTLEMENT_MODE=auto

PHP_PER_USDC=56.5

# Fallback only — per-corridor fees (all 0.70%) come from lib/fx/corridors.ts
# and are passed to settlement.move as fee_bps. Capped at MAX_FEE_BPS = 200.
PLATFORM_FEE_BPS=70
FIXED_FEE_CENTS=0
QUOTE_TTL_SECONDS=30
DEFAULT_KYC_TIER=1
USDC_AVAILABLE_MICRO=1000000000000000
USDT_AVAILABLE_MICRO=0
USDT_BUFFER_AGE_MS=0
USE_MOCK_APIS=false

# Decentralized Seal + Walrus audit storage. The Seal committee, threshold,
# package and policy live in config/seal.<env>.json, not here (config/README.md).
# Setting SEAL_KEY_SERVER_ENDPOINTS, SEAL_KEY_SERVER_URLS, SEAL_KEY_SERVER_MODE,
# SEAL_THRESHOLD, SEAL_PACKAGE_ID, SEAL_POLICY_OBJECT_ID or SEAL_APPROVE_TARGET
# fails boot by name. Only the health-check timeout and alert webhook stay in env.
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
SEAL_HEALTH_TIMEOUT_MS=10000
SEAL_ALERT_WEBHOOK_URL=

SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_BASE_URL=https://api.sumsub.com

ADMIN_EMAIL=staff@splash.finance
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
CUSTOMER_ORGANIZATION=
CUSTOMER_SESSION_SECRET=
CUSTOMER_SELF_SIGNUP_ENABLED=false
CUSTOMER_RECOVERY_EMAIL=support@splash.finance
# Not read by the app: experiments/confidential only.
FEATURE_CONFIDENTIAL_TRANSFER=false
FEATURE_DUAL_FUNDING=true
FUNDING_PROVIDER_STRIPE_ENABLED=true
FUNDING_PROVIDER_AIRWALLEX_ENABLED=true
FUNDING_ASSET_USDC_ENABLED=true
FUNDING_ASSET_USDSUI_ENABLED=true
FUNDING_ASSET_USDT_ENABLED=false
FUNDING_RAIL_SUI_NATIVE_ENABLED=true
FUNDING_RAIL_CCTP_ENABLED=true
FUNDING_CCTP_ETHEREUM_ENABLED=true
FUNDING_CCTP_SOLANA_ENABLED=true
FUNDING_CCTP_BASE_ENABLED=true
FUNDING_CCTP_ARBITRUM_ENABLED=true
USDSUI_TYPE=
FUNDING_DISCOUNT_BPS=0
FUNDING_SELF_CUSTODY_STAGED_LIMIT_USD=10000
FUNDING_DEPOSIT_DERIVATION_SECRET=
FUNDING_CCTP_DEPOSIT_ADDRESSES_JSON=
FUNDING_WEBHOOK_SECRET=
FUNDING_DEX_QUOTES_JSON=
STRIPE_SECRET_KEY=
AIRWALLEX_API_KEY=
