SUI_NETWORK=testnet
SUI_RPC_URL=
# ── Package IDs (post-split) ────────────────────────────────────────────────
# splash_core publishes to mainnet. Required.
SPLASH_CORE_PACKAGE_ID=
# splash_custody publishes ONLY when the Labuan e-money licence is granted.
# Leave EMPTY in Phase 0 — that is the regulatory posture, not a misconfiguration.
# Batch settlement will refuse with a licence-named error. See STATUS.md.
SPLASH_CUSTODY_PACKAGE_ID=
# The tenant-granted payout delegation the operator settles batches with (A-11).
# Granted by the tenant from their own wallet via settlement::grant_delegation,
# transferred to the operator, TTL <= 30 days. Absent in Phase 0 along with the
# rest of custody.
SPLASH_PAYOUT_DELEGATION_ID=
# Legacy single-package id. Still honoured for pre-split deployments: when
# SPLASH_CORE_PACKAGE_ID is unset, core AND custody both resolve to this.
SPLASH_PACKAGE_ID=
SPLASH_TREASURY_ID=
SPLASH_PEG_STATE_ID=
SPLASH_COMPLIANCE_CONFIG_ID=
SPLASH_COMPLIANCE_CAP_ID=
DEEPBOOK_POOL_ID=
DEEPBOOK_QUOTE_TYPE=
SPLASH_ADMIN_CAP_ID=
SPLASH_BUSINESS_ACCOUNT_ID=
SPLASH_TRANSFER_COIN_ID=
SPLASH_TEST_RECIPIENT_ADDRESS=
SPLASH_SETTLEMENT_REGISTRY_ID=
SPLASH_PEG_USDC_DEVIATION_PPM=0
SPLASH_PEG_USDT_DEVIATION_PPM=0
SUI_PEG_UPDATE_GAS_BUDGET=10000000
SUI_RECORD_SETTLEMENT_GAS_BUDGET=10000000
USDC_TYPE=
USDT_TYPE=
USDT_BUFFER_ID=
MIN_USDC_FLOAT_MICRO=100000000
TREASURY_ADDRESS=
# Optional. Nothing needs Enoki: USDC transfers carry no gas and Splash pays
# its own settlement gas. Only the health probe reads it.
ENOKI_API_KEY=
OPERATOR_SUI_ADDRESS=

# Stablecoin lane (lib/payments/stablecoin-lane.ts) — Sui MAINNET only. The
# Splash-controlled address that receives the audit-anchor fee inside the same
# transaction as the payment. Needed only when STABLECOIN_ANCHOR_FEE=on; while
# stablecoin transfers are free, leave it blank here and set it in .env.local.
SPLASH_FEE_ADDRESS_MAINNET=
# Stablecoin transfers are free. Out of Splash (not to a Splash user's wallet),
# the audit-anchor fee — 0.02%, min 0.05, max 5 USDC — applies only when this
# is `on`, and then needs SPLASH_FEE_ADDRESS_MAINNET. Off (blank) by default.
STABLECOIN_ANCHOR_FEE=
# Wallet transfers go gasless (Sui carries USDC without a network fee, so the
# sending wallet needs no SUI). Blank = on. `off` makes the sending wallet pay
# gas in SUI again — the switch for a protocol change, without a deploy.
STABLECOIN_GASLESS=
# Chainalysis free sanctions API (public.chainalysis.com). Blank: wallet
# recipients are saved unscreened and reach mainnet only by admin attestation.
CHAINALYSIS_SANCTIONS_API_KEY=
# Mainnet fullnode (gRPC-web) for the stablecoin lane. Blank:
# https://fullnode.mainnet.sui.io:443. Use a provider you trust — the lane reads
# balances and executes signed transfers through it.
SUI_MAINNET_RPC_URL=
# The Splash demo x402 seller (/api/x402/demo/corridor-fees) is paid 0.01 USDC
# on Sui mainnet at this address. Blank: the demo seller is off. Real USDC.
X402_DEMO_PAY_TO=
# Treasury (USDC → Ondo USDY on Sui, in the business's own wallet) stays a
# preview until Ondo confirms eligibility. Keep false until it has.
USDY_ONDO_ELIGIBILITY_CONFIRMED=false
# Server-side secret. Required for real settlement on serverless production.
# Must be a funded Ed25519 or Secp256k1 suiprivkey matching OPERATOR_SUI_ADDRESS.
OPERATOR_SUI_PRIVATE_KEY=
# auto uses the SDK signer, then a fully configured CLI. It simulates only when
# USE_MOCK_APIS=true. live requires a real signer; simulate is explicit demo mode.
SUI_SETTLEMENT_MODE=auto

# Labuan Settlement Engine (Splash Labuan Ltd — Labuan FSA Money Broker + DFS)
LABUAN_API_BASE_URL=https://settlement.splash-labuan.internal
LABUAN_API_KEY=
LABUAN_OTC_MIN_USD=10000

# FX Rates (MYR→USD via authorized dealer bank)
MYR_TO_USD_RATE=
FALLBACK_MYR_USD_RATE=0.213

# Intercompany Banking (Maybank KL → Maybank Labuan)
MAYBANK_INTERCOMPANY_ENABLED=true

PHP_PER_USDC=56.5

# Local-currency payouts: 0.70% of the amount, every corridor, nothing fixed
# (2026-09-26). Per-corridor fees live in lib/fx/corridors.ts (all 70 bps) and
# are passed to settlement.move's settle_payment / settle_batch as fee_bps;
# this is the fallback only for a currency with no corridor. Hard ceiling
# enforced on-chain by MAX_FEE_BPS = 200.
PLATFORM_FEE_BPS=70
# A fixed fee per payout, in cents, on top of the percentage. None: 0.
FIXED_FEE_CENTS=0
QUOTE_TTL_SECONDS=30
DEFAULT_KYC_TIER=1
USDC_AVAILABLE_MICRO=1000000000000000
USDT_AVAILABLE_MICRO=0
USDT_BUFFER_AGE_MS=0
USE_MOCK_APIS=false
# Launch scope. Blank = full. `stablecoin` opens USDC on Sui only: fiat,
# payout runs, treasury and the settling cron jobs answer 403, and production
# then boots with mocks off without PDAX, Walrus, Stripe or Airwallex. It still
# needs the settlement signer, which records a business's verification on Sui
# (lib/launch-scope-rules.ts). It refuses mocks, demo mode,
# card funding, treasury execution and SUI_SETTLEMENT_MODE=live.
LAUNCH_SCOPE=

# Phase 1 demo and delivery ladder
NEXT_PUBLIC_DEMO_MODE=false
STORED_BALANCE_CORRIDORS=
# false = SWEEP_ACCOUNT is never recommended or offered, and a sweep is refused before
# a recipient, transfer or ledger line is written. Read at startup like every env var:
# it takes effect on restart. Only matters once the custody phase is on.
SWEEP_ACCOUNT_ENABLED=true
TREASURY_EXECUTION_ENABLED=false
RATE_HOLD_HOURS=48

# Walrus publisher/aggregator. Mock round-trip is used when USE_MOCK_APIS=true.
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=

# Seal threshold encryption. The committee, threshold, package and policy are
# NOT environment variables: they live in config/seal.<env>.json, committed,
# one file per environment, so every machine reads the same list. See
# config/README.md. Setting SEAL_KEY_SERVER_ENDPOINTS, SEAL_THRESHOLD,
# SEAL_PACKAGE_ID, SEAL_POLICY_OBJECT_ID, SEAL_KEY_SERVER_MODE or
# SEAL_APPROVE_TARGET here fails boot by name. What stays in env is
# operational: the health-check timeout and the alert webhook.
SEAL_HEALTH_TIMEOUT_MS=10000
SEAL_ALERT_WEBHOOK_URL=

# PDAX payout adapter. Mock payout is used when USE_MOCK_APIS=true.
PDAX_API_BASE_URL=
PDAX_API_KEY=

SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_BASE_URL=https://api.sumsub.com

# Staff and workspace credentials. Blank on purpose: a value here is a
# working login for anyone who clones the repository. Set real ones in
# .env.local. lib/env.ts refuses to boot production without
# ADMIN_SESSION_SECRET, or with the demo password this file used to ship.
# In production, staff sign-in refuses every login unless ADMIN_EMAIL,
# ADMIN_PASSWORD and ADMIN_SESSION_SECRET are all set (lib/server/admin-auth.ts).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Business workspace session. Local development falls back to the demo account;
# production must configure these values and should leave self-signup disabled
# unless backed by a real customer provisioning flow.
# CUSTOMER_EMAIL / CUSTOMER_PASSWORD are GONE. There is no single
# deployment credential any more: accounts are rows in `users` with a
# scrypt hash, created through /api/auth/signup. Setting either here fails
# boot by name, because a password in a file that governs nothing still
# reads as a control.
CUSTOMER_ORGANIZATION=
CUSTOMER_SESSION_SECRET=
CUSTOMER_SELF_SIGNUP_ENABLED=false
CUSTOMER_RECOVERY_EMAIL=support@splash.finance

NEXT_PUBLIC_APP_URL=http://localhost:3000
# The domain every passkey is bound to (lib/auth/passkey.ts). A passkey's Sui
# address — the main admin's Splash wallet — is tied to it, so it is decided
# ONCE, before anyone creates a real passkey. Production: splashz.xyz (the root
# domain), so passkeys work on v1.splashz.xyz today and app.splashz.xyz or any
# other subdomain later — see docs/GO-LIVE-HANDOVER.md. Blank here: the host of
# NEXT_PUBLIC_APP_URL (localhost in development).
PASSKEY_RP_ID=
NEXT_PUBLIC_SUPPORT_EMAIL=support@splash.finance

# Email delivery (WS1). Verification links and password resets go through it, and a
# membership grant requires a verified mailbox. `console` prints the link to the server
# log and is refused in production; set `resend` with its API key and a sender address.
EMAIL_TRANSPORT=console
EMAIL_API_KEY=
EMAIL_FROM=
# Extra public origins allowed for state-changing requests when the app runs
# behind a reverse proxy, comma-separated (e.g. https://v1.splashz.xyz).
# The forwarded host is trusted automatically; use this for extra domains.
ALLOWED_ORIGINS=
# Proxies in front of the app: the client address for rate limits is read
# this many places from the end of X-Forwarded-For. Blank = 1 (nginx on the
# Droplet). Add one for each proxy in front of nginx, such as a CDN.
TRUSTED_PROXY_HOPS=
# App Platform only: do-connecting-ip. Its X-Forwarded-For holds DigitalOcean's
# ingress address, so without this every visitor shares one rate-limit bucket.
# Leave blank on the Droplet: nginx would pass a caller's own header through.
CLIENT_IP_HEADER=

# ─── AI Copilot ────────────────────────────────────────────────────────────────
# MemWal (Walrus Memory) — privacy-first behavioral memory for the Copilot.
# Server-side ONLY. Set the real values in .env.local (gitignored), never here.
#   MEMWAL_PRIVATE_KEY — delegate Ed25519 private key (hex). SECRET.
#   MEMWAL_ACCOUNT_ID  — Walrus Memory account object ID on Sui (the delegate
#                        key must be registered on this account in the MemWal
#                        dashboard, or the relayer returns 401).
#   MEMWAL_SERVER_URL  — relayer URL (default https://relayer.memory.walrus.xyz).
#   MEMWAL_NAMESPACE   — namespace PREFIX (default "splash-copilot"). Every org
#                        reads and writes only "<prefix>:org:<key>", its own
#                        partition (lib/server/memwal-scope.ts).
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=splash-copilot

# Optional — enables Claude generation in the Copilot. Without it the Copilot
# still works (MemWal recall + grounded domain responses).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Smart Treasury — Ondo USDY (two-bucket) ─────────────────────────────────
# Yield comes from Ondo USDY (T-bill backed, native on Sui). FLOATING rate —
# never hardcode an APY. Available balance is USDC at 0% (instant); Smart
# Treasury is USDY (variable, T+1–T+3 withdrawal). Move funds by swapping
# USDC↔USDY on a Sui DEX, NOT direct Ondo mint/redeem. Measured 2026-09-24:
# Sui has very little USDY liquidity (100 USDC came back ~14% short, 1,000
# ~70%), so treasury quotes check the live market (Cetus aggregator) first.
USDY_TYPE=
SPLASH_USDC_TREASURY_ID=
SPLASH_USDY_TREASURY_ID=
USDY_NET_APY_PCT=3.5
# USDY's price comes from Ondo's own oracle on Ethereum (USDYOracleWrapper),
# read free through a public node. Set ETHEREUM_RPC_URL to a node you trust
# before Treasury moves money. USDY_ORACLE=off skips it.
ETHEREUM_RPC_URL=
USDY_ORACLE=
# Fallback when the oracle is not read: a hand-set price and when it was
# observed. Without the time it is never used; after 6 hours it is stale.
USDY_REDEMPTION_USD=
USDY_REDEMPTION_AS_OF=
USDY_SWAP_VENUE=cetus
USDY_SWAP_SLIPPAGE_BPS=30
USDY_WITHDRAWAL_DAYS=2
# Time-boxed introductory promo (tagged as such in UI). Leave blank to disable.
SPLASH_PROMO_APY_PCT=
SPLASH_PROMO_UNTIL=
# Scheduler-only secret for cron routes (update-peg, accrue-yield). Fail-closed.
CRON_SECRET=

# ─── Peg monitor — DeepBook V3 (the only price source) ───────────────────────
# On-chain CLOB price for the USDC/USDT peg: free, no key. No reading pauses
# payouts. Defaults to the MAINNET indexer (deepest stable liquidity) even on
# testnet — the peg is a market fact. Use the native USDT_USDC pool (liquid);
# dead/wrapped pools are auto-rejected. (Pyth was a second source until Hermes
# began requiring a paid key on 26 Aug 2026; Splash does not use it.)
DEEPBOOK_INDEXER_URL=https://deepbook-indexer.mainnet.mystenlabs.com
# Dollar-stablecoin/USDC pools to read; the most-traded one with a spread under
# 1% decides. Default USDSUI_USDC,SUIUSDE_USDC,USDT_USDC (USDT_USDC alone is too thin).
DEEPBOOK_STABLE_PAIRS=
DEEPBOOK_PEG_TOLERANCE_BPS=100
DEEPBOOK_TIMEOUT_MS=2500

# Not read by the app: experiments/confidential only. Native Circle USDC does
# not expose confidential balances on Sui; the cryptography is devnet-only.
FEATURE_CONFIDENTIAL_TRANSFER=false

# Dual funding. Runtime options are served by /api/funding/options and are
# revalidated server-side when sessions and deposits are accepted.
FEATURE_DUAL_FUNDING=true
FUNDING_PROVIDER_STRIPE_ENABLED=true
FUNDING_PROVIDER_AIRWALLEX_ENABLED=true
FUNDING_ASSET_USDC_ENABLED=true
FUNDING_ASSET_USDSUI_ENABLED=true
# Research-gated. Keep false until every gate in experiments/funding/RESEARCH.md passes.
FUNDING_ASSET_USDT_ENABLED=false
FUNDING_RAIL_SUI_NATIVE_ENABLED=true
FUNDING_RAIL_CCTP_ENABLED=true
# The four CCTP source chains are on here by choice. lib/env.ts declares them
# default false; lib/funding/registry.ts, which decides, treats blank as on.
# Set false to close a chain.
FUNDING_CCTP_ETHEREUM_ENABLED=true
FUNDING_CCTP_SOLANA_ENABLED=true
FUNDING_CCTP_BASE_ENABLED=true
FUNDING_CCTP_ARBITRUM_ENABLED=true
USDSUI_TYPE=
# Off: a payout funded from held USDC is 0.70% like every other.
FUNDING_DISCOUNT_BPS=0
FUNDING_SELF_CUSTODY_STAGED_LIMIT_USD=10000
# Server-side only. Used to derive recoverable per-business Sui deposit keys.
FUNDING_DEPOSIT_DERIVATION_SECRET=
# JSON: {"<business-account-id>":{"ETHEREUM":"0x...","SOLANA":"...","BASE":"0x...","ARBITRUM":"0x..."}}
FUNDING_CCTP_DEPOSIT_ADDRESSES_JSON=
# Shared secret required on POST /api/funding/deposits outside demo mode.
FUNDING_WEBHOOK_SECRET=
# Optional live DEX quote snapshot keyed by USDSUI/USDT. See RESEARCH.md.
FUNDING_DEX_QUOTES_JSON=
STRIPE_SECRET_KEY=
AIRWALLEX_API_KEY=

# Trust & compliance page gate: "true" removes the DRAFT watermark and noindex.
# Flip only after counsel signs off on the /trust copy.
LEGAL_APPROVED=

# On-chain proof panel (landing How-it-works): explorer links render only
# when set. Fill with real testnet settlement digests after a verified deploy.
PROOF_TX_1=
PROOF_TX_2=

# ── Wallet / onboarding / custody spec ──────────────────────────────────────
# Cap split (Phase 6): TreasuryCap is the ONLY capability that can take value
# out of a custodial object. Cold 2-of-3, never online. AdminCap governs and
# cannot move a coin — scripts/check-treasury-cap.mjs enforces that.
SPLASH_TREASURY_CAP_ID=
# Cap split (§5): the hot AnchorCap for audit anchors, receipts and peg
# pushes. There is no fallback to SPLASH_ADMIN_CAP_ID: audit anchors, peg
# pushes (the scheduled /api/cron/update-peg refresh included) and settlement
# records throw while this is unset (lib/server/sui-settlement.ts). Set it
# together with SPLASH_CAP_REGISTRY_ID below.
SPLASH_ANCHOR_CAP_ID=
# Phase 7 break-glass: the shared CapRegistry. Required alongside the anchor
# cap — a revoked capability is refused on chain (abort 210), not off it.
SPLASH_CAP_REGISTRY_ID=
# zkLogin (§4). Ships disabled; the password path is unaffected. Register a
# SEPARATE OAuth client per environment (Mysten best practice + IACR mitigation).
FEATURE_ZKLOGIN=false
ZKLOGIN_GOOGLE_CLIENT_ID=
ZKLOGIN_MICROSOFT_CLIENT_ID=
# KYB money gate (§3.2). Default OFF: enabling it before orgs have a real
# lifecycle row would put the demo workspace into read-only.
FEATURE_KYB_GATE=false
# Killed-entity domains (§2.4), comma-separated. ccacc.io is always denied.
KILLED_ENTITY_DOMAINS=
