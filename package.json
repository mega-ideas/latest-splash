{
  "name": "splash-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "npm run check:core && npm run check:copy && eslint",
    "check:core": "node scripts/check-core-no-balance.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "setup:sui-pilot": "powershell -ExecutionPolicy Bypass -File scripts/setup-sui-pilot.ps1",
    "bootstrap:testnet": "node --use-system-ca --experimental-strip-types --env-file=.env.local scripts/bootstrap-testnet.ts",
    "test:auth": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/customer-session.test.mjs tests/wallet-onboarding.test.mjs",
    "test:seal:integration": "node --use-system-ca --experimental-strip-types --env-file=.env.local tests/seal-decentralized.integration.mjs",
    "test:funding": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/funding-registry.test.mjs tests/funding-policy.test.mjs",
    "test:oxwal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/oxwal-state-machine.test.mjs tests/oxwal-agent.test.mjs tests/oxwal-policy.test.mjs tests/oxwal-compose.test.mjs tests/oxwal-approval-queue.test.mjs tests/oxwal-evidence.test.mjs tests/oxwal-safety.test.mjs tests/oxwal-frontend.test.mjs tests/oxwal-e2e.test.mjs tests/oxwal-authority.test.mjs tests/comparison-baselines.test.mjs tests/money-path.test.mjs tests/deepbook-liquidity-guard.test.mjs tests/deepbook-pool-whitelist.test.mjs tests/payout-authorization.test.mjs tests/core-invariant-check.test.mjs tests/treasury-nav.test.mjs tests/settlement-minimum.test.mjs tests/receipt-share.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/ledger-invariant.test.mjs tests/proposal-persistence.test.mjs tests/wallet-identity-db.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@base-ui/react": "^1.4.1",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@mysten-incubation/memwal": "^0.0.7",
    "@mysten/deepbook-v3": "^1.3.6",
    "@mysten/seal": "^1.1.3",
    "@mysten/sui": "^2.16.2",
    "@shinami/clients": "^0.10.0",
    "@tanstack/react-query": "^5.100.9",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "node": "^26.3.0",
    "papaparse": "^5.5.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-to-print": "^3.3.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "postcss": "^8.5.10"
  }
}
